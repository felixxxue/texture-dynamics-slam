+    m_k = hdr[0]; m_L = hdr[1]; m_scoring = (ScoringType)hdr[2]; m_weighting = (WeightingType)hdr[3];
+    createScoringObject();
+    m_words.clear(); m_nodes.clear();
+    m_nodes.resize(hdr[4]);
+    m_nodes[0].id = 0;
+    for(int nid=1; nid<hdr[4]; nid++)
+    {
+        int32_t parent; uint8_t isWord; double w;
+        f.read((char*)&parent, sizeof(parent));
+        f.read((char*)&isWord, sizeof(isWord));
+        m_nodes[nid].id = nid;
+        m_nodes[nid].parent = parent;
+        m_nodes[parent].children.push_back(nid);
+        m_nodes[nid].descriptor.create(1, F::L, CV_8U);
+        f.read((char*)m_nodes[nid].descriptor.ptr<uchar>(0), F::L);
+        f.read((char*)&w, sizeof(w));
+        m_nodes[nid].weight = w;
+        if(isWord)
+        {
+            int wid = m_words.size();
+            m_words.resize(wid+1);
+            m_nodes[nid].word_id = wid;
+            m_words[wid] = &m_nodes[nid];
+        }
+    }
+    return f.good();
+}
 
